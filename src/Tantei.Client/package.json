{
  "name": "tantei-client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "generate:api": "kubb generate && oxfmt --write src/api/gen",
    "lint": "run-s lint:oxlint lint:eslint",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "lint:check": "run-s lint:check:oxlint lint:check:eslint",
    "lint:check:oxlint": "oxlint . --deny-warnings",
    "lint:check:eslint": "eslint . --max-warnings 0 --cache",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.124",
    "@nuxt/ui": "^4.10.0",
    "@tanstack/vue-query": "^5.101.4",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.41",
    "vue-i18n": "^11.4.8",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@iconify-json/circle-flags": "^1.2.10",
    "@intlify/unplugin-vue-i18n": "^11.2.5",
    "@kubb/plugin-fetch": "^5.0.0",
    "@kubb/plugin-ts": "^5.0.0",
    "@kubb/plugin-vue-query": "^5.0.0",
    "@kubb/plugin-zod": "^5.0.0",
    "@storybook/addon-docs": "^10.5.10",
    "@storybook/vue3-vite": "^10.5.10",
    "@tanstack/vue-query-devtools": "^6.1.38",
    "@tsconfig/node24": "^24.0.5",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.8.1",
    "eslint-plugin-oxlint": "~1.79.0",
    "eslint-plugin-storybook": "^10.5.10",
    "eslint-plugin-vue": "~10.10.0",
    "jiti": "^2.7.0",
    "kubb": "^5.0.1",
    "npm-run-all2": "^9.0.3",
    "oxfmt": "0.64.0",
    "oxlint": "~1.79.0",
    "storybook": "^10.5.10",
    "typescript": "~6.0.3",
    "vite": "^8.2.2",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.10"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  },
  "packageManager": "npm@11.17.0",
  "allowScripts": {
    "esbuild@0.27.7": true,
    "esbuild@0.25.12": true
  }
}
